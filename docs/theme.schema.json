{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swarm Arena theme, version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "stylesheet",
    "fallback",
    "categoryColors",
    "states"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "stylesheet": {
      "type": "string",
      "pattern": "\\.css$"
    },
    "fallback": {
      "const": "base-classic-placeholder"
    },
    "categoryColors": {
      "$ref": "#/$defs/colors",
      "required": [
        "rock",
        "paper",
        "scissors",
        "lizard",
        "spock",
        "human",
        "zombie"
      ]
    },
    "nameColors": {
      "$ref": "#/$defs/colors"
    },
    "outlineColors": {
      "$ref": "#/$defs/colors"
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "R",
          "P",
          "Sc",
          "L",
          "Sp",
          "H",
          "Z",
          "Hs",
          "Hi",
          "Zi",
          "Zh",
          "Zc",
          "Za"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    }
  },
  "$defs": {
    "colors": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "rock",
          "paper",
          "scissors",
          "lizard",
          "spock",
          "human",
          "zombie"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[a-fA-F0-9]{6}$"
      }
    },
    "state": {
      "type": "object",
      "required": [
        "frames",
        "fps",
        "pivot",
        "facingDegrees"
      ],
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\.png$"
          }
        },
        "fps": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        },
        "pivot": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "facingDegrees": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        }
      }
    }
  }
}
